+            and any(t.requires_grad for t in (expert_output, sorted_gate))
+        )
+        and expert_output.numel() > 0
+    )
+    if not eligible:
+        raise RuntimeError(
+            "experimental Praxis MoE combine requires the pinned fused CUDA "
+            "path; refusing the reference's eager fallback"
+        )
