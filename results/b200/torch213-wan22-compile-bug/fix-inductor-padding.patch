+# Inductor's comprehensive stride padding miscompiles the Wan2.2 decoder once
+# its mid block and first two up blocks share a graph (torch >= 2.13 traces a
+# decoder call as one graph): a residual up block's shortcut reads its input
+# with padded channels-first strides while that input was written
+# channels-last, so the frames and the cache are wrong (or the read runs out
+# of bounds).
+COMPILE_OPTIONS = {"comprehensive_padding": False}
+
+
+def compile_decode(fn):
+    """``torch.compile`` for a Wan VAE decode callable: one static graph per
+    shape, broken around the causal-conv cache."""
+    return torch.compile(fn, fullgraph=False, dynamic=False, options=COMPILE_OPTIONS)
+
